NODE_ENV=development
PORT=3000
# En producción usá la connection string de Neon con TLS.
# Ejemplo recomendado: postgresql://...?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://...
JWT_SECRET=cambiar-por-secreto-aleatorio-de-al-menos-32-caracteres
FRONTEND_URL=http://localhost:5173
# Producción: solo origen HTTPS, sin path/query. Ej: https://la-red-padle.vercel.app
# En producción: Base32 de al menos 32 caracteres (160 bits). No reutilizar JWT_SECRET.
ADMIN_TOTP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
# Versión Graph elegida según la configuración/documentación vigente de Meta, ej. v26.0
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
